# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined by Metro at build time.
# Create a free project at https://supabase.com → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: OpenAI key for the AI assistant (proxy through an Edge Function in prod!)
EXPO_PUBLIC_AI_ENABLED=false
